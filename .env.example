APP_NAME=Convert
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# SasPay production: server-side secrets only; API key must use sk_live_.
SASPAY_API_KEY=
SASPAY_WEBHOOK_SECRET=

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true behind HTTPS in production.
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Decimal bytes: 1 Mo = 1,000,000 bytes. Limits are informational in phase 1.
CONVERSION_GUEST_MAX_BYTES=25000000
CONVERSION_GUEST_HOURLY_JOBS=5
CONVERSION_GUEST_DAILY_JOBS=10
CONVERSION_GUEST_CONCURRENT_JOBS=1
CONVERSION_GUEST_TIMEOUT=60
CONVERSION_GUEST_RETENTION_HOURS=1
CONVERSION_USER_MAX_BYTES=100000000
CONVERSION_USER_HOURLY_JOBS=20
CONVERSION_USER_DAILY_JOBS=50
CONVERSION_USER_CONCURRENT_JOBS=2
CONVERSION_USER_TIMEOUT=180
CONVERSION_USER_RETENTION_HOURS=24

# Phase 2: budgets globaux et réservations de stockage, en octets décimaux.
CONVERSION_MAX_ACTIVE_JOBS=20
CONVERSION_MAX_RUNNING_JOBS=1
CONVERSION_GLOBAL_STORAGE_BYTES=2000000000
CONVERSION_GUEST_STORAGE_BYTES=100000000
CONVERSION_USER_STORAGE_BYTES=400000000
# Must stay higher than the 240-second conversion worker timeout.
DB_QUEUE_RETRY_AFTER=360

CONVERSION_IMAGES_ENABLED=true
# Under Apache, set the absolute path to the PHP CLI executable with GD.
CONVERSION_PHP_BINARY=
CONVERSION_IMAGE_MAX_PIXELS=6000000
CONVERSION_IMAGE_MAX_DIMENSION=8192
CONVERSION_IMAGE_BATCH_FILES=5

CONVERSION_DOCUMENTS_ENABLED=true
# Defaults use the isolated .tools paths in this project. Set absolute paths on another host.
# CONVERSION_DOCUMENT_PYTHON="C:/laragon/www/convert-app/.tools/python/Scripts/python.exe"
# CONVERSION_LIBREOFFICE="C:/laragon/www/convert-app/.tools/libreoffice/program/soffice.com"

CONVERSION_MEDIA_ENABLED=true
CONVERSION_MEDIA_MAX_RUNNING=1
# Set absolute native executable paths on another host, then run php artisan media:verify.
# CONVERSION_MEDIA_PYTHON="C:/laragon/www/convert-app/.tools/python/Scripts/python.exe"
# CONVERSION_FFMPEG="C:/laragon/www/convert-app/.tools/ffmpeg/bin/ffmpeg.exe"
# CONVERSION_FFPROBE="C:/laragon/www/convert-app/.tools/ffmpeg/bin/ffprobe.exe"

# Commons CC0 requires a real local verification marker; this flag alone cannot enable it.
EXTERNAL_DOWNLOADS_ENABLED=false
# EXTERNAL_USER_AGENT="Convert/1.0 (mailto:support@example.org)"
# Enable only after production validation and a configured canonical HTTPS APP_URL.
SEO_INDEXING_ENABLED=false
MAIL_TIMEOUT=10

# OCR / offline speech recognition. These default paths stay project-local.
RECOGNITION_ENABLED=true
# RECOGNITION_PYTHON="C:/laragon/www/convert-app/.tools/python/Scripts/python.exe"
# RECOGNITION_TESSERACT="C:/laragon/www/convert-app/.tools/tesseract/tesseract.exe"
# RECOGNITION_TESSDATA="C:/laragon/www/convert-app/.tools/tesseract/tessdata"
# RECOGNITION_WHISPER="C:/laragon/www/convert-app/.tools/whisper/Release/whisper-cli.exe"
# RECOGNITION_MODEL="C:/laragon/www/convert-app/.tools/whisper/ggml-tiny.bin"
